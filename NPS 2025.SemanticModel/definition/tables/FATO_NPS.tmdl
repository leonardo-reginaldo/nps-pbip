	partition FATO_NPS = m
		mode: import
		queryGroup: FATO
		source = ```
				let
				    Fonte = Csv.Document(File.Contents("G:\Meu Drive\Consultorias\NPS_FICTICIO\nps_ficticio_100k.csv"),[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"id", Int64.Type}, {"id_paciente", Int64.Type}, {"data_hora", type datetime}, {"ubs", Int64.Type}, {"setor", type text}, {"nota_recomendacao", Int64.Type}}),
				    
				    // 1. Excluir linhas onde a coluna 'setor' está nula, vazia ou apenas com espaços
				    #"Setor Nao Vazio" = Table.SelectRows(#"Tipo Alterado", each [setor] <> null and [setor] <> "" and Text.Trim([setor]) <> ""),
				    
				    // 2. Ordenar por id_paciente e por data_hora (do mais recente para o mais antigo)
				    #"Linhas Classificadas" = Table.Sort(#"Setor Nao Vazio",{{"id_paciente", Order.Ascending}, {"data_hora", Order.Descending}}),
				    
				    // Função para manter a resposta mais recente e descartar outras do mesmo paciente dentro da janela de 15 dias
				    FiltrarJanela15Dias = (tabela as table) as table =>
				        let
				            Linhas = Table.ToRecords(tabela),
				            Filtrado = List.Accumulate(
				                Linhas,
				                {},
				                (estado, atual) =>
				                    if List.IsEmpty(estado) then
				                        {atual} // Mantém sempre a resposta mais recente (primeira da lista)
				                    else
				                        let
				                            UltimaDataMantida = List.Last(estado)[data_hora],
				                            DiferencaDias = Duration.Days(UltimaDataMantida - atual[data_hora])
				                        in
				                            // Só mantém a resposta se ela tiver ocorrido há 15 dias ou mais após a última mantida
				                            if DiferencaDias >= 15 then
				                                estado & {atual}
				                            else
				                                estado
				            ),
				            Resultado = Table.FromRecords(Filtrado, Value.Type(tabela))
				        in
				            Resultado,
				            
				    // 3. Aplicar o filtro de 15 dias agrupando por id_paciente
				    #"Agrupado por Paciente" = Table.Group(#"Linhas Classificadas", {"id_paciente"}, {{"TabelaFiltrada", FiltrarJanela15Dias, type table}}),
				    
				    // 4. Recombinar as tabelas filtradas em um único resultado
				    #"Tabela Final" = Table.Combine(#"Agrupado por Paciente"[TabelaFiltrada]),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Tabela Final",{{"data_hora", type date}})
				in
				    #"Tipo Alterado1"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

