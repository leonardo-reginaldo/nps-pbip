	partition DIM_CALENDARIO = m
		mode: import
		queryGroup: DIMENSÕES
		source = ```
				// Tabela: DIM_CALENDARIO
				let
				    // 1. Extrair apenas as datas únicas que existem na coluna data_hora da FATO_NPS
				    ListaDatasComHora = FATO_NPS[data_hora],
				    DatasApenas = List.Transform(ListaDatasComHora, Date.From),
				    DatasUnicas = List.Distinct(DatasApenas),
				    
				    // 2. Converter a lista de datas em tabela
				    #"Tabela Criada" = Table.FromList(DatasUnicas, Splitter.SplitByNothing(), {"Data"}, null, ExtraValues.Error),
				    #"Tipo Alterado Data" = Table.TransformColumnTypes(#"Tabela Criada",{{"Data", type date}}),
				    
				    // 3. Ordenar as datas (opcional, mas recomendado para organização)
				    #"Datas Ordenadas" = Table.Sort(#"Tipo Alterado Data",{{"Data", Order.Ascending}}),
				    
				    // 4. Criar colunas solicitadas
				    #"Ano Adicionado" = Table.AddColumn(#"Datas Ordenadas", "Ano", each Date.Year([Data]), Int64.Type),
				    
				    // Semestre / Ano (Ex: 1S/2024, 2S/2024)
				    #"Semestre/Ano Adicionado" = Table.AddColumn(#"Ano Adicionado", "Semestre/Ano", each Text.From(if Date.Month([Data]) <= 6 then 1 else 2) & "S/" & Text.From(Date.Year([Data])), type text),
				    
				    // Trimestre / Ano (Ex: T1/2024, T2/2024)
				    #"Trimestre/Ano Adicionado" = Table.AddColumn(#"Semestre/Ano Adicionado", "Trimestre/Ano", each "T" & Text.From(Date.QuarterOfYear([Data])) & "/" & Text.From(Date.Year([Data])), type text),
				    
				    // Mês / Ano (Ex: Jan/2024, Fev/2024) + Coluna de Ordenação MêsAnoNum (Ex: 202401)
				    #"Nome do Mês" = Table.AddColumn(#"Trimestre/Ano Adicionado", "Mês/Ano", each Text.Proper(Text.Start(Date.MonthName([Data], "pt-BR"), 3)) & "/" & Text.From(Date.Year([Data])), type text),
				    #"MêsAnoNum Adicionado" = Table.AddColumn(#"Nome do Mês", "MesAnoNum", each Date.Year([Data]) * 100 + Date.Month([Data]), Int64.Type),
				    
				    // Dia da Semana (Ex: Segunda-Feira, Terça-Feira) + Dia da Semana Numérico
				    #"Dia da Semana Adicionado" = Table.AddColumn(#"MêsAnoNum Adicionado", "Dia da Semana", each Text.Proper(Date.DayOfWeekName([Data], "pt-BR")), type text),
				    #"DiaDaSemanaNum Adicionado" = Table.AddColumn(#"Dia da Semana Adicionado", "DiaDaSemanaNum", each Date.DayOfWeek([Data], Day.Monday) + 1, Int64.Type)
				in
				    #"DiaDaSemanaNum Adicionado"
				```

	annotation PBI_NavigationStepName = Navegação

